# Copy to .env.local and fill in. .env.local is gitignored; keep it that way.
# Only NEXT_PUBLIC_* values reach the browser — never add that prefix to a secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google refuses a Desktop-client token exchange without a secret, and every
# install needs this value, so /api/client-config serves it openly. PKCE is what
# makes that harmless. Unset, the endpoint returns 503 and
# `artist-mcp connect google` cannot complete.
GOOGLE_DESKTOP_CLIENT_SECRET=

# Optional. Set to `staging` to render staging deployment metadata locally.
DEPLOY_ENV=

# ── Hosted MCP (issue #55) ────────────────────────────────────────────────
# These were removed when tokens moved onto the user's machine, with a note
# saying not to reintroduce them without reviving the hosted design
# deliberately. That is what this is: /api/mcp serves named users whose tokens
# this server holds, and it says so to their faces. The local package is
# unaffected and still keeps its tokens on the user's own disk.
#
# Unset, /api/mcp refuses to serve rather than serving something half-working.

# Reads a connection on behalf of a user who holds no browser session, so it
# bypasses RLS by design. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts refresh and access tokens at rest via pgcrypto. Never stored in the
# database — passed as an argument on every call, so a dump yields ciphertext
# and nothing that opens it. Generate with `openssl rand -base64 48`. Changing
# it makes every stored connection unreadable and everyone reconnects.
TOKEN_ENCRYPTION_KEY=

# Web OAuth clients, for connecting a hosted account from the browser.
#
# Separate registrations from the ones the published package uses. Those are
# desktop clients, and the Google one's secret is served openly by
# /api/client-config — harmless there, because PKCE is what protects a desktop
# client. A web client's secret is not harmless, so it must be a different
# registration and must never be served.
#
# Each provider needs this redirect URI registered, per environment:
#   https://<site>/api/auth/microsoft/callback
#   https://<site>/api/auth/google/callback
#
# These paths are what the previous hosted design registered and Entra still
# has, so Microsoft needs no redirect changes — only a secret.
#
# Unset, connecting is refused with a message saying so rather than sending
# someone to a provider error page about a client that does not exist.
ARTIST_MCP_WEB_MS_CLIENT_ID=
ARTIST_MCP_WEB_MS_CLIENT_SECRET=
ARTIST_MCP_WEB_GOOGLE_CLIENT_ID=
ARTIST_MCP_WEB_GOOGLE_CLIENT_SECRET=
