{
  "name": "@manudota/artist-mcp",
  "version": "3.0.0",
  "description": "MCP server that reads your OneNote notes in Claude Desktop or Codex, with optional Gmail and Calendar as supporting evidence. Signs in on your own machine; writes are opt-in per install.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onenote",
    "microsoft-graph",
    "gmail",
    "google-calendar",
    "claude",
    "claude-desktop",
    "codex",
    "musicians"
  ],
  "homepage": "https://artist-mcp.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ManudotaORG/artist-mcp"
  },
  "bugs": {
    "url": "https://github.com/ManudotaORG/artist-mcp/issues"
  },
  "type": "module",
  "bin": {
    "artist-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./dispatch": "./dist/dispatch.js",
    "./grants": "./dist/grants.js",
    "./audit": "./dist/audit.js",
    "./oauth": "./dist/oauth.js",
    "./client": "./dist/client.js",
    "./tasks": "./dist/tasks.js",
    "./task-pages": "./dist/task-pages.js",
    "./task-tick": "./dist/task-tick.js"
  },
  "files": [
    "dist",
    "agent-pack"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-agent-registry.mjs && chmod +x dist/index.js",
    "test": "pnpm run build && node --test --test-timeout=60000 test/*.test.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "context-budget": "node scripts/context-budget.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "unpdf": "^2.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^7.0.2"
  }
}
