{
  "name": "@manudota/artist-mcp",
  "version": "0.8.0",
  "description": "MCP server that reads your OneNote notes, with optional Gmail and Calendar as supporting evidence, via a hosted connection.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ManudotaORG/artist-mcp"
  },
  "type": "module",
  "bin": {
    "artist-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-pack"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-agent-registry.mjs && tsc -p tsconfig.json && chmod +x dist/index.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
