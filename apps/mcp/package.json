{
  "name": "@manudota/artist-mcp",
  "version": "1.3.0",
  "description": "MCP server that reads your OneNote notes, with optional Gmail and Calendar as supporting evidence, via a hosted connection.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ManudotaORG/artist-mcp"
  },
  "type": "module",
  "bin": {
    "artist-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./dispatch": "./dist/dispatch.js",
    "./oauth": "./dist/oauth.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "agent-pack"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-agent-registry.mjs && chmod +x dist/index.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
