{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Named, because TypeScript 6 and later include no @types package
    // unless asked: without it, every node: import is unresolved.
    "types": ["node"],
    // The web app imports this package as a workspace dependency and needs to
    // typecheck against it, so the build emits declarations.
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
