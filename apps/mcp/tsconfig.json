{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // The web app imports this package as a workspace dependency and needs to
    // typecheck against it, so the build emits declarations.
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
