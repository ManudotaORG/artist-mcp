{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      // The web app imports the MCP package through its exports map, which
      // points into dist. On a machine that has built before, dist is already
      // there and lint passes; on a fresh checkout it is not, and the import
      // resolver reports every subpath as unresolvable. CI found this and local
      // runs could not.
      "dependsOn": [
        "^build"
      ]
    }
  }
}
