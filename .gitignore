# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# turbo
.turbo

# supabase CLI scratch state
supabase/.temp

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit .env.example only
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify derived output (regenerate with /graphify .)
graphify-out/

# disposable, agent-owned working memory installed by the artist workflow pack
.artist/local/

# local-only test fixtures (messy OneNote test notebook source)
test-fixtures/

# Deno regenerates this on each run; the edge function pins its deps in the
# import specifier, and CI does not run with a frozen lockfile.
deno.lock
